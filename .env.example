# ============================================================================
#  .env.example — ORTAM DEĞİŞKENİ ŞABLONU
# ----------------------------------------------------------------------------
#  Bu dosya repoya commit EDİLİR ve yalnızca ÖRNEK/BOŞ değerler içerir.
#  Gerçek değerleri `.env` dosyasına yazın:
#
#      cp .env.example .env
#
#  `.env` dosyası .gitignore ile korunuyor ve ASLA commit edilmez.
#  Buraya hiçbir zaman gerçek bir API anahtarı, şifre veya token yazmayın.
# ============================================================================


# --- Anthropic Claude API ---------------------------------------------------
# Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kullanılacak model kimliği
# [DOLDURUN] ör. claude-sonnet-4 / claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-4

# Tek yanıtta üretilecek maksimum token
ANTHROPIC_MAX_TOKENS=4096

# 0.0 = deterministik, 1.0 = yaratıcı. Fatura/sayısal analizde düşük tutun.
ANTHROPIC_TEMPERATURE=0.0


# --- Uygulama ---------------------------------------------------------------
# development | staging | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Para birimi ve vergi oranı (src/example_billing.py varsayılanı %20)
DEFAULT_CURRENCY=TRY
VAT_RATE=0.20


# --- Veri Kaynağı -----------------------------------------------------------
# [DOLDURUN] Fatura verisi nereden geliyor? Dosya yolu, DB veya API.
# Kullanmıyorsanız bu bloğu silin.
# DATABASE_URL=postgresql://user:password@localhost:5432/billing
# BILLING_DATA_PATH=./data/faturalar.csv


# --- Harici Servisler -------------------------------------------------------
# [DOLDURUN] Kullandığınız diğer servisleri buraya ekleyin.
# BILLING_API_BASE_URL=https://api.example.com/v1
# BILLING_API_KEY=changeme
